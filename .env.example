# ── Groupe Nexus CRM — variables d'environnement ─────────────────────────────
# Copier vers .env (dev local) — sur Vercel : Settings → Environment Variables.

# Postgres (dev local : docker-compose.dev.yml | prod : Neon via Vercel Marketplace)
DATABASE_URL="postgres://nexus:nexus@localhost:5455/nexus"

# Secret JWT de session — générer : openssl rand -base64 32
AUTH_SECRET=""

# Clé de chiffrement des secrets (SIP, Google, webhooks) — openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# URL publique de l'app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── voip.ms ──────────────────────────────────────────────────────────────────
# Menu principal → SOAP/REST API : activer, définir le mot de passe, autoriser l'IP.
VOIPMS_API_USERNAME=""
VOIP_MS_API_PASSWORD=""
# Prod (IPs Vercel dynamiques) : proxy API sur la passerelle (IP fixe)
VOIPMS_API_PROXY_URL=""
VOIPMS_API_PROXY_TOKEN=""

# Passerelle vocale — URL WebSocket (ex. wss://voice.example.com:8443)
NEXT_PUBLIC_SIP_WSS_URL=""

# ── Google Calendar (OAuth « application web ») ──────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Twilio (seulement si le fournisseur téléphonie est basculé sur Twilio) ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_TWIML_APP_SID=""

# Clé webhook créée par le seed (n8n / Facebook Lead Ads)
WEBHOOK_SEED_KEY=""

# Protège /api/cron/* (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Domaine SIP voip.ms (POP le plus proche)
VOIPMS_SIP_DOMAIN="montreal1.voip.ms"

# ── Moteur SMS (assistants IA) ───────────────────────────────────────────────
# Mode d'envoi : dry_run (défaut — journalise sans envoyer) | sandbox | live.
# Valeur absente ou inconnue => dry_run. Le mode live exige EN PLUS
# SMS_LIVE_CONFIRMED=true (deux drapeaux pour envoyer pour vrai).
SMS_MODE=dry_run
SMS_LIVE_CONFIRMED=
# Numéros autorisés en mode sandbox (E.164, séparés par des virgules)
TEST_PHONE_ALLOWLIST=
# Clé API Twilio dédiée aux SMS (la clé voix reste TWILIO_API_KEY_SID/SECRET)
TWILIO_SMS_API_KEY_SID=
TWILIO_SMS_API_KEY_SECRET=
# Messaging Service Twilio (console → Messaging → Services)
TWILIO_MESSAGING_SERVICE_SID=
# ── Fournisseurs IA (phases 3+) ──────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
