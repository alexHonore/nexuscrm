# ─────────────────────────────────────────────────────────────────────────────
# Groupe Nexus — Passerelle vocale : variables d'environnement
# Copier vers « .env » (ou laisser setup.sh le créer) puis ajuster.
# ─────────────────────────────────────────────────────────────────────────────

# Nom de domaine COMPLET de la passerelle (enregistrement DNS A -> IP du KVM).
# C'est ce nom qui sert dans les règles Host(...) de Traefik.
DOMAIN=voice.example.com

# Jeton secret du relais API voip.ms. Le CRM (Vercel) doit envoyer la même
# valeur dans VOIPMS_API_PROXY_TOKEN. Générer avec : openssl rand -hex 32
PROXY_TOKEN=remplacez-moi

# IP publique du serveur (setup.sh la détecte automatiquement avec curl -4).
PUBLIC_IP=203.0.113.7

# Interface média de rtpengine. En général identique à PUBLIC_IP
# (Hostinger/OVH/DigitalOcean : l'IP publique est directement sur la carte).
# Nuage avec NAT 1:1 (AWS/GCP/Azure) : forme IP_privée!IP_publique.
RTP_INTERFACE=203.0.113.7

# ── Mode Traefik (par défaut — KVM avec la pile n8n) ─────────────────────────

# Nom du réseau Docker EXTERNE où vit le conteneur Traefik de la pile n8n.
# setup.sh le détecte (docker network ls / docker inspect du conteneur
# Traefik). Pile n8n officielle installée dans /root -> « root_default ».
TRAEFIK_NETWORK=root_default

# Entrypoint HTTPS de Traefik (gabarit n8n officiel : « websecure » = :443).
TRAEFIK_ENTRYPOINT=websecure

# Résolveur de certificats configuré dans Traefik (gabarit n8n officiel :
# « mytlschallenge »).
TRAEFIK_CERTRESOLVER=mytlschallenge

# Port WebSocket EN CLAIR de Kamailio (interne : Traefik -> ws-bridge -> ici).
# Ne pas l'exposer à Internet ; setup.sh ne l'ouvre que pour les sous-réseaux
# Docker.
WS_PORT=5066

# ── Mode autonome seulement (docker-compose.standalone.yml, annexe) ──────────

# Courriel utilisé par Caddy/Let's Encrypt pour les avis d'expiration.
# Inutile en mode Traefik (le résolveur de Traefik a déjà son courriel).
ACME_EMAIL=admin@example.com
