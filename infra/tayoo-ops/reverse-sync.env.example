# /srv/supabase/apps/nexuscrm/reverse-sync.env — mode 600, propriétaire root.
# Lu ligne à ligne par reverse-sync.sh (jamais « source ») ; clés inconnues refusées.
#
# L'ANCIENNE base (Supabase cloud weasuzxazxjnfzxzqtsw), par le pooler en mode
# SESSION (port 5432) — pas le transactionnel 6543 : la copie est une seule
# longue transaction avec COPY. Supabase → Connect → Session pooler.
OLD_DATABASE_URL=postgresql://postgres.weasuzxazxjnfzxzqtsw:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Garde : l'URL ci-dessus DOIT contenir cette référence, sinon refus.
OLD_PROJECT_REF=weasuzxazxjnfzxzqtsw

# Défauts (à ne changer que si l'instance a été recréée autrement) :
# SOURCE_CONTAINER=sb-nexuscrm-db-1
# SOURCE_ENV=/srv/supabase/projects/nexuscrm/.env
# STATE_DIR=/srv/supabase/apps/nexuscrm/reverse-sync
# Image des outils pg_dump/psql (défaut : celle du conteneur source, même version) :
# PG_CLIENT_IMAGE=postgres:17-alpine
