# ── Groupe Nexus CRM sur Tayoo Ops — réglages de l'application hébergée ─────
# Sur le VPS : /srv/supabase/apps/nexuscrm/app.env (mode 600), écrit par
# receive-env.py depuis le .env de production. Ce fichier-ci ne liste que les
# NOMS et ce qui DIFFÈRE de Vercel ; les valeurs secrètes restent celles de la
# production (même AUTH_SECRET, même APP_ENCRYPTION_KEY — sans la même clé, les
# secrets SIP / Google / webhooks chiffrés en base deviennent illisibles).

# ── Ce qui change par rapport à Vercel ───────────────────────────────────────
# Postgres de l'instance `nexuscrm`, sur SON réseau Docker privé (rien ne sort
# du serveur, d'où TLS coupé explicitement — remplace l'astuce « _localhost »).
DATABASE_URL=postgresql://postgres:<mot de passe de l'instance>@db:5432/postgres?application_name=nexuscrm_app
DATABASE_SSL=disable
# Un seul processus Node longue durée : 30 reste le bon ordre de grandeur.
# DATABASE_POOL_MAX=30

# Le trafic n'arrive que par le tunnel Cloudflare : l'IP du visiteur est
# `cf-connecting-ip`. Sans ce réglage, les en-têtes Vercel (absents ici, donc
# falsifiables) seraient crus et le limiteur de connexions contournable.
TRUSTED_PROXY=cloudflare

# Domaine public (inliné au BUILD : changer de domaine = reconstruire l'image).
NEXT_PUBLIC_APP_URL=https://web-nexuscrm.tayoo.app

# Nouveau secret pour les crons n8n (différent de celui de Vercel).
CRON_SECRET=<openssl rand -hex 32>

# Prudence tant que la bascule n'est pas faite : aucun texto réel.
SMS_MODE=dry_run
SMS_LIVE_CONFIRMED=

# ── Identiques à la production Vercel (copiés tels quels) ────────────────────
AUTH_SECRET=
APP_ENCRYPTION_KEY=
NEXT_PUBLIC_SIP_WSS_URL=
VOIPMS_API_USERNAME=
VOIP_MS_API_PASSWORD=
VOIPMS_API_PROXY_URL=
VOIPMS_API_PROXY_TOKEN=
VOIPMS_SIP_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_SMS_API_KEY_SID=
TWILIO_SMS_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TEST_PHONE_ALLOWLIST=
SMS_ALLOWED_REGIONS=
WEBHOOK_SEED_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RESEND_API_KEY=
EMAIL_FROM=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
LLM_DEFAULT_CLASSIFIER=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
APP_TIMEZONE=
